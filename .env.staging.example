# ArenaLine staging/development environment.
# Copy this file to /opt/arenaline-staging/.env and replace all placeholders.

COMPOSE_PROJECT_NAME=arenaline-staging
POSTGRES_VOLUME_NAME=arenaline-staging_postgres_data
MEDIA_VOLUME_NAME=arenaline-staging_media_data
PORTAL_ENVIRONMENT=staging
APP_PORT=8089

DJANGO_SECRET_KEY=replace-with-a-different-long-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8089

POSTGRES_DB=arenaline_staging
POSTGRES_USER=arenaline_staging
POSTGRES_PASSWORD=replace-with-a-different-long-random-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

TIME_ZONE=America/New_York
SECURE_COOKIES=0
SECURE_HSTS_SECONDS=0

# Keep staging email disabled so copied production users never receive test mail.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=staging@example.invalid
DEFAULT_TEMP_PASSWORD=

# The staging checkout will usually track an explicit feature branch/ref.
PORTAL_UPDATE_CHANNEL=preview
